# ==============================================================================
# LedgerPilot Environment Configuration Template
# Duplicate this file to .env.local for local development. Never commit .env.local!
# ==============================================================================

# App Configuration
NEXT_PUBLIC_APP_NAME="LedgerPilot"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (PostgreSQL via Supabase or Local Docker)
# Direct connection URL for migrations & pooled connection URL for runtime
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]?schema=public"

# Supabase Authentication & Storage (Phase 1 & Phase 2)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="ledgerpilot-documents"

# NextAuth / Auth Secrets (Alternative Auth configuration)
NEXTAUTH_SECRET="your-generate-secret-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# AI Pipeline - OpenAI API (Vision OCR, LLM Extraction, Whisper Fallback)
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o"

# AI Pipeline - Groq (High-speed Speech-to-Text via Whisper-large-v3)
GROQ_API_KEY="gsk_your-groq-api-key"

# Storage & Upload Limits
MAX_UPLOAD_SIZE_MB=25

# Encryption Key for PII & Sensitive Fields (AES-256 32-byte hex string)
DATA_ENCRYPTION_KEY="your-32-byte-hex-encryption-key-for-pii"
