// LedgerPilot – Prisma Schema
// AI-native CRM & bookkeeping platform for CPAs and accounting firms

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum BillingTier {
  FREE
  PRO
  ENTERPRISE
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  CLIENT
}

enum TaxEntity {
  LLC
  S_CORP
  C_CORP
  SOLE_PROP
  PARTNERSHIP
}

enum ClientStatus {
  ACTIVE
  ONBOARDING
  ARCHIVED
}

enum StagingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentRequestStatus {
  REQUESTED
  SUBMITTED
  VERIFIED
}

// ──────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────

/// Accounting firm / organization
model Firm {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  billingTier BillingTier @default(FREE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users   User[]
  clients Client[]
}

/// Platform user (admin, accountant, or client-portal user)
model User {
  id             String   @id @default(uuid())
  firmId         String
  email          String   @unique
  fullName       String
  role           UserRole
  hashedPassword String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  firm             Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  assignedClients  Client[]          @relation("AssignedAccountant")
  uploadedInvoices Invoice[]         @relation("UploadedBy")
  voiceNotes       VoiceNote[]
  documentRequests DocumentRequest[] @relation("RequestedBy")

  @@index([firmId])
}

/// Client company managed by the firm
model Client {
  id             String       @id @default(uuid())
  firmId         String
  companyName    String
  taxEntity      TaxEntity
  einTaxId       String?
  status         ClientStatus @default(ONBOARDING)
  assignedUserId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  firm             Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  assignedUser     User?             @relation("AssignedAccountant", fields: [assignedUserId], references: [id], onDelete: SetNull)
  invoices         Invoice[]
  voiceNotes       VoiceNote[]
  documentRequests DocumentRequest[]

  @@index([firmId])
  @@index([assignedUserId])
}

/// Uploaded invoice with AI-extracted data
model Invoice {
  id              String        @id @default(uuid())
  clientId        String
  uploadedById    String
  invoiceNumber   String?
  vendorName      String
  transactionDate DateTime      @db.Date
  subtotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  category        String?
  fileUrl         String
  stagingStatus   StagingStatus @default(PENDING)
  aiRawResponse   String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  items      InvoiceItem[]

  @@index([clientId])
  @@index([uploadedById])
}

/// Line item on an invoice
model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Voice note recorded by an accountant for a client
model VoiceNote {
  id                String   @id @default(uuid())
  clientId          String
  userId            String
  audioUrl          String
  transcription     String?  @db.Text
  structuredSummary Json?
  billableHours     Decimal? @db.Decimal(6, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

/// Document request sent to a client
model DocumentRequest {
  id               String                @id @default(uuid())
  clientId         String
  requestedById    String
  title            String
  description      String?               @db.Text
  status           DocumentRequestStatus @default(REQUESTED)
  dueDate          DateTime?             @db.Date
  submittedFileUrl String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([requestedById])
}
